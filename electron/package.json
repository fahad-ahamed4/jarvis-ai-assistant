{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS — Real-Life AI Assistant (Windows desktop app)",
  "author": "fahad-ahamed4",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fahadahamed4.jarvis",
    "productName": "JARVIS",
    "copyright": "Copyright © 2026 fahad-ahamed4",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "default-site.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "archer.exe"
    },
    "nsis": {
      "artifactName": "archer-setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
